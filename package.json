{
  "name": "n8n-hubspot-custom-object-association-integrity-guard",
  "version": "1.0.0",
  "description": "Scheduled n8n workflow that audits HubSpot custom objects for mandatory Company and Deal associations, flags orphaned records and alerts RevOps in Slack. Safe by default: demo data, DRY_RUN and SANDBOX_MODE.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "association-integrity-guard": "src/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node src/index.js",
    "demo": "node src/index.js --demo",
    "audit": "node src/index.js",
    "discover": "node scripts/discover-schema.js",
    "properties:create": "node scripts/create-flag-properties.js",
    "config:env": "node scripts/config-to-env.js",
    "build:workflow": "node scripts/build-workflow.js",
    "check:workflow": "node scripts/build-workflow.js --check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "n8n",
    "hubspot",
    "custom-objects",
    "associations",
    "revops",
    "data-quality",
    "slack"
  ],
  "author": "DH Robin | dhRobin Systems (https://dhrobinsystems.com)",
  "homepage": "https://dhrobinsystems.com",
  "license": "MIT"
}
