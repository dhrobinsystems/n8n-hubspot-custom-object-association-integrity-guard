# n8n-hubspot-custom-object-association-integrity-guard
# Copy to .env for the CLI, or set the same variables in the n8n environment.
# Every value below is a placeholder or a safe default. Never commit real values.

# --- HubSpot -------------------------------------------------------------------
# Private app scopes: crm.schemas.custom.read, crm.objects.custom.read, crm.objects.companies.read,
# crm.objects.deals.read, plus crm.objects.custom.write (flag writes) and crm.schemas.custom.write
# (only for `npm run properties:create`). While this stays a placeholder the guard runs in demo mode.
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN_HERE
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: a portal ID that SANDBOX_MODE accepts even if its account type is not SANDBOX/DEVELOPER_TEST.
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID_HERE

# --- Rules -----------------------------------------------------------------------
# Single-line JSON produced by `npm run config:env` from config.json (n8n cannot read files).
GUARD_CONFIG_JSON=YOUR_GUARD_CONFIG_JSON_HERE

# --- Safety switches (fail safe) --------------------------------------------------
# Only false/0/no/off turns DRY_RUN or SANDBOX_MODE off. Only true/1/yes/on turns FLAG_WRITES_ENABLED on.
DRY_RUN=true
SANDBOX_MODE=true
FLAG_WRITES_ENABLED=false

# --- Slack ------------------------------------------------------------------------
# Production alerts go to SLACK_WEBHOOK_URL only when DRY_RUN=false and SANDBOX_MODE=false.
# Otherwise alerts go to SLACK_SANDBOX_WEBHOOK_URL, or are only logged if that is a placeholder.
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE
SLACK_SANDBOX_WEBHOOK_URL=YOUR_SLACK_SANDBOX_WEBHOOK_URL_HERE
ALERT_ON_CLEAN_RUN=false
SLACK_INCLUDE_RECORD_NAMES=false
SLACK_MAX_SAMPLES=10

# --- Tuning (each overrides the matching "settings" value in GUARD_CONFIG_JSON) ----
GRACE_PERIOD_HOURS=24
MAX_RECORDS_PER_OBJECT=10000
HUBSPOT_PAGE_SIZE=100
HUBSPOT_BATCH_SIZE=100
MAX_FLAG_UPDATES_PER_RUN=200
ORPHAN_RATE_CIRCUIT_BREAKER=0.5
CIRCUIT_BREAKER_MIN_SAMPLE=20
VERIFY_TARGETS_EXIST=true

# --- One-time property setup (npm run properties:create) ---------------------------
FLAG_PROPERTY_GROUP_NAME=YOUR_PROPERTY_GROUP_NAME_HERE

# --- Testing only -----------------------------------------------------------------
# Pins the audit clock (ISO 8601). Leave empty in production.
AUDIT_NOW=

# --- n8n host settings (set on the n8n instance, not read by the guard) -------------
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false   lets Code nodes and expressions read $env
# GENERIC_TIMEZONE=UTC                 the Schedule Trigger's cron runs in this timezone
